{
    "name": "ghostwriter/empty-vs-strict-benchmark",
    "description": "Benchmarking empty vs strict comparisons in PHP",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nathanael Esayeas",
            "email": "nathanael.esayeas@protonmail.com",
            "homepage": "https://github.com/ghostwriter",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/ghostwriter/empty-vs-strict-benchmark",
    "support": {
        "issues": "https://github.com/ghostwriter/empty-vs-strict-benchmark/issues",
        "source": "https://github.com/ghostwriter/empty-vs-strict-benchmark",
        "docs": "https://github.com/ghostwriter/empty-vs-strict-benchmark",
        "rss": "https://github.com/ghostwriter/empty-vs-strict-benchmark/releases.atom",
        "security": "https://github.com/ghostwriter/empty-vs-strict-benchmark/security/advisories/new"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/ghostwriter"
        },
        {
            "type": "paypal",
            "url": "https://paypal.me/codepoet"
        }
    ],
    "_comment": [
        "#BlackLivesMatter",
        "#FreePalestine",
        "#StandWithIran",
        "#StandWithUkraine",
        "#StopGenocide"
    ],
    "require": {
        "php": "~8.4.0 || ~8.5.0 || ~8.6.0",
        "ghostwriter/filesystem": "^0.2.1",
        "ghostwriter/shell": "^0.1.6"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "boundwize/structarmed": "^0.14.15",
        "ghostwriter/phpunit-assertions": "^0.1.0",
        "mockery/mockery": "^1.6.12",
        "phpbench/phpbench": "^1.7.0",
        "phpunit/phpunit": "^13.2.4"
    },
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "config": {
        "allow-plugins": {
            "ghostwriter/coding-standard": true
        },
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.999"
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            },
            "abandoned": {
                "block": true,
                "audit": "fail"
            }
        },
        "preferred-install": {
            "*": "dist"
        },
        "sort-packages": true,
        "strict-psr-autoloader": true,
        "use-parent-dir": false
    },
    "extra": {
        "thanks": {
            "name": "ghostwriter/empty-vs-strict-benchmark",
            "url": "https://github.com/ghostwriter/empty-vs-strict-benchmark"
        }
    },
    "scripts": {
        "cache:clear": "rm -rf ./.cache/*",
        "check": [
            "@cache:clear",
            "@composer validate",
            "@test"
        ],
        "infection": [
            "@xdebug",
            "vendor/ghostwriter/coding-standard/tools/phar/infection --min-covered-msi=0 --min-msi=0 --show-mutations --threads=max"
        ],
        "phpbench": "vendor/ghostwriter/coding-standard/tools/phar/phpbench run --report='extends:aggregate,cols:[benchmark,subject,revs,its,mem_peak,mode,rstdev]' --time-unit=milliseconds ./tests/Benchmark",
        "phpunit": [
            "@xdebug",
            "vendor/bin/phpunit --do-not-cache-result --colors=always"
        ],
        "test": [
            "@phpunit",
            "@infection"
        ],
        "xdebug": "@putenv XDEBUG_MODE=coverage"
    }
}
